{
  "name": "@grain/cli",
  "version": "0.7.2",
  "description": "A command line tool for the Grain language.",
  "main": "src/main.js",
  "type": "module",
  "engines": {
    "node": ">=24.21"
  },
  "scripts": {
    "clean": "del-cli \"src/artifacts/*.exe\" \"src/artifacts/*.bc.cjs\"",
    "link": "npm link",
    "format": "prettier --write .",
    "check-format": "prettier --check .",
    "build-pkg": "pkg ./package.json --output ../pkg/grain"
  },
  "pkg": {
    "sea": true,
    "bytecode": false,
    "compress": "Zstd",
    "options": [
      "disable-warning=ExperimentalWarning"
    ],
    "assets": "src/artifacts/*.bc.cjs",
    "ignore": [
      "src/artifacts/*.exe",
      "**/node_modules/*/test/**",
      "**/node_modules/*/docs/**",
      "**/node_modules/commander/typings/**"
    ]
  },
  "bin": {
    "grain": "src/main.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/grain-lang/grain.git"
  },
  "keywords": [
    "grain",
    "cli"
  ],
  "author": "Oscar Spencer",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/grain-lang/grain/issues"
  },
  "homepage": "https://github.com/grain-lang/grain#readme",
  "dependencies": {
    "@grain/stdlib": "0.7.2",
    "commander": "^8.1.0"
  },
  "devDependencies": {
    "@yao-pkg/pkg": "github:spotandjake/pkg#58560b0c20991e43f84005b9ad97ec6d424b5abc",
    "del-cli": "^7.0.0",
    "prettier": "^3.9.8"
  }
}
