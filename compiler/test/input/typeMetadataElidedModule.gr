@elideTypeInfo
module Main

// No Type Data
record NoData {
  noData: Number,
}
assert toString({ noData: 1, }: NoData) == "{ <unknown field>: 1, }"

// External types still have type info
from "./baseType.gr" include BaseType
assert toString({ baseType: 1, }: BaseType.BaseType) == "{ baseType: 1, }"
