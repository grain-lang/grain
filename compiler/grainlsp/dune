(executable
 (name grainlsp)
 (public_name grainlsp)
 (package grainlsp)
 (modules grainlsp)
 (modes exe js)
 (flags
  (:standard
   (:include ./config/flags.sexp)))
 (libraries
  cmdliner
  grain_utils
  grain_language_server
  grain_formatting
  dune-build-info))

(rule
 (alias js)
 (deps grainlsp.bc.cjs)
 (action (progn)))

(rule
 (target grainlsp.bc.cjs)
 (deps grainlsp.bc.js)
 (action
  (copy %{deps} %{target})))
